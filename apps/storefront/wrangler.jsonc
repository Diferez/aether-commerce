{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aether-storefront",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
