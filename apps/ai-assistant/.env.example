AETHER_API_BASE_URL=http://localhost:8787
AETHER_CART_TOKEN_SECRET=
AI_DEPLOYMENT_ENVIRONMENT=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=600
AI_ASSISTANT_ENABLED=true
AI_MUTATIONS_ENABLED=true
AI_INTENT_CONFIDENCE_THRESHOLD=0.75
AI_MUTATION_CONFIDENCE_THRESHOLD=0.90
AI_MAX_GRAPH_STEPS=12
AI_MAX_LLM_CALLS_PER_REQUEST=5
AI_MAX_TOOL_CALLS_PER_REQUEST=6
AI_MAX_PRODUCTS_PER_RESPONSE=5
AI_MAX_CONVERSATION_MESSAGES=20
AI_REQUEST_TIMEOUT_SECONDS=25
AI_INTERNAL_HTTP_RETRIES=2
AI_INTERNAL_CIRCUIT_FAILURE_THRESHOLD=3
AI_INTERNAL_CIRCUIT_RESET_SECONDS=30
AI_CATALOG_CACHE_TTL_SECONDS=60
AI_RATE_LIMIT_MESSAGES_PER_MINUTE=8
AI_RATE_LIMIT_MESSAGES_PER_HOUR=80
AI_RATE_LIMIT_ANONYMOUS_PER_DAY=40
AI_RATE_LIMIT_AUTHENTICATED_PER_DAY=200
AI_MAX_CONCURRENT_REQUESTS=20
AI_MAX_INPUT_CHARACTERS=4000
AI_LOG_MESSAGE_CONTENT=false
AI_REDACT_PII=true
AI_STORE_CONVERSATIONS=true
AI_CONVERSATION_RETENTION_DAYS=30
AI_RUN_MIGRATIONS_ON_STARTUP=false
AI_DAILY_REQUEST_BUDGET=
AI_EVAL_MAX_CASES=10
AI_OPERATIONS_TOKEN=
AI_CORS_ALLOWED_ORIGINS=*
OTEL_ENABLED=false
OTEL_SERVICE_NAME=aether-ai-assistant
# Local development can use sqlite:///./.data/assistant.sqlite3.
# Production should use PostgreSQL.
DATABASE_URL=sqlite:///./.data/assistant.sqlite3
SUPABASE_DATABASE_URL=
SUPABASE_DB_PASSWORD=
REDIS_URL=
