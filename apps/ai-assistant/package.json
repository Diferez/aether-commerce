{
  "name": "@aether/ai-assistant",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist --config ./wrangler.jsonc",
    "deploy:development": "wrangler deploy --config ./wrangler.development.json --keep-vars",
    "deploy": "wrangler deploy --config ./wrangler.production.json --keep-vars",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint worker.ts assistant.test.ts",
    "test": "vitest run --root ../.. apps/ai-assistant/assistant.test.ts"
  },
  "dependencies": {
    "@aether/core": "workspace:*",
    "@langchain/core": "1.2.5",
    "@langchain/google-genai": "2.2.0",
    "@langchain/langgraph": "1.4.8",
    "@langchain/langgraph-checkpoint": "1.1.3",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260812.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.120.0"
  }
}
