{
  "name": "@aether/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --config ./wrangler.jsonc --env-file ./.dev.vars --show-interactive-dev-session false",
    "build": "wrangler deploy --dry-run --outdir dist --config ./wrangler.jsonc",
    "deploy:development": "wrangler deploy --config ./wrangler.development.json --keep-vars",
    "deploy": "wrangler deploy --config ./wrangler.production.json --keep-vars",
    "types": "wrangler types ./src/worker-configuration.d.ts --config ./wrangler.jsonc",
    "typecheck": "pnpm types && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ignore-pattern src/worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config ./wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config ./wrangler.production.json",
    "db:seed": "pnpm db:seed:base && pnpm db:seed:demo",
    "db:seed:base": "wrangler d1 execute DB --local --file ../../database/core/migrations/0002_seed_demo.sql --config ./wrangler.jsonc",
    "db:seed:demo": "wrangler d1 execute DB --local --file ../../database/core/migrations/0004_demo_operational_data.sql --config ./wrangler.jsonc",
    "db:seed:remote": "wrangler d1 execute DB --remote --file ../../database/core/migrations/0002_seed_demo.sql --config ./wrangler.production.json && wrangler d1 execute DB --remote --file ../../database/core/migrations/0004_demo_operational_data.sql --config ./wrangler.production.json"
  },
  "dependencies": {
    "@aether/core": "workspace:*",
    "@aether/api-core": "workspace:*",
    "@aether/observability": "workspace:*",
    "@aether/schemas": "workspace:*",
    "@hono/zod-validator": "^0.8.0",
    "@langchain/core": "1.2.5",
    "@langchain/google-genai": "2.2.0",
    "@langchain/langgraph": "1.4.8",
    "@sentry/cloudflare": "10.70.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.34",
    "jose": "^6.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "typescript": "^5.9.0",
    "wrangler": "^4.120.0"
  }
}
