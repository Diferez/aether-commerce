{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "paths": {
      "@aether-commerce/config-schema": ["packages/config-schema/src/index.ts"]
    }
  },
  // The .tsx example files (apps/storefront, apps/admin) need real react/next
  // node_modules to typecheck, and apps/api/src/index.ts needs real
  // @sentry/cloudflare plus Cloudflare Workers' ambient globals
  // (ScheduledController, ExecutionContext, ExportedHandler) - templates/client
  // isn't a pnpm workspace member, so none of that is locally resolvable
  // here. This config's own job is narrower: verify @aether-commerce/config-schema
  // resolves against monorepo source (see README.md). Both get their real,
  // authoritative check from validate-client-template.mjs's other pass - a
  // genuine `pnpm install` + `pnpm validate` (+ a `wrangler deploy --dry-run`
  // for apps/api) inside a freshly generated client, where react/next/
  // @sentry/cloudflare and Workers types all resolve normally because it's a
  // real, standalone npm-style project.
  "exclude": ["apps/**/*.tsx", "apps/api/src/**/*.ts"]
}
