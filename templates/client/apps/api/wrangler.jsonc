{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "client-store-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER_GLOBAL",
      "namespace_id": "4101",
      "simple": {
        "limit": 240,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMITER_ACCOUNT",
      "namespace_id": "4104",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMITER_MUTATION",
      "namespace_id": "4102",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMITER_SENSITIVE",
      "namespace_id": "4103",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    "AETHER_ENV": "development",
    "APP_ORIGIN_STORE": "http://localhost:3000",
    "APP_ORIGIN_ADMIN": "http://localhost:3001",
    "APP_STORE_BASE_PATH": "",
    "STORE_CURRENCY": "USD",
    "STORE_LOCALE": "en-US",
    "STORE_COUNTRY": "US",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "AI_PROVIDER": "gemini",
    "ADMIN_CHAT_MUTATIONS_ENABLED": "true",
    "ADMIN_CHAT_MAX_INPUT_CHARACTERS": "4000",
    "ADMIN_CHAT_PENDING_ACTION_TTL_MINUTES": "5",
    "BRAND_NAME": "client-store",
    "EMAIL_FROM": "client-store <onboarding@resend.dev>",
    "OBSERVABILITY_SERVICE_NAME": "client-store-api",
    "AI_ASSISTANT_NAME": "client-store Chat",
    "AETHER_PACKAGE_OWNER": "aether",
    "PLATFORM_GITHUB_WORKFLOW_FILE": "aether-update.yml"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "client-store",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "../../database/migrations"
    }
  ]
}
