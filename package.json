{
  "name": "aether-commerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.6.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:api": "pnpm --filter @aether/api dev",
    "dev:storefront": "pnpm --filter @aether/storefront dev",
    "dev:storefront:e2e": "cross-env NEXT_PUBLIC_AETHER_AI_URL=http://localhost:8090 NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsuZXhhbXBsZS5jb20k NEXT_PUBLIC_PORTFOLIO_URL=https://portfolio.example.com pnpm --filter @aether/storefront exec next dev --port 3010",
    "dev:admin": "pnpm --filter @aether/admin dev",
    "env:sync": "node scripts/sync-env.mjs",
    "deploy:preflight": "node scripts/check-deploy-config.mjs",
    "build": "turbo build",
    "build:api": "pnpm --filter @aether/api build",
    "build:storefront": "pnpm --filter @aether/storefront build",
    "build:admin": "pnpm --filter @aether/admin build",
    "deploy:development:api": "pnpm --filter @aether/api run deploy:development",
    "deploy:development:storefront": "pnpm --filter @aether/storefront run deploy:development",
    "deploy:development:assistant": "wrangler deploy --config apps/ai-assistant/wrangler.development.json --keep-vars",
    "deploy:api": "pnpm --filter @aether/api run deploy",
    "deploy:storefront": "pnpm --filter @aether/storefront run deploy",
    "deploy:assistant": "wrangler deploy --config apps/ai-assistant/wrangler.production.json --keep-vars",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "check:boundaries": "node scripts/check-platform-boundaries.mjs",
    "test:e2e": "playwright test",
    "test:e2e:assistant": "playwright test tests/e2e/assistant-widget.spec.ts --project=desktop",
    "db:generate": "pnpm --filter @aether/api db:generate",
    "db:migrate:local": "pnpm --filter @aether/api db:migrate:local",
    "db:seed": "pnpm --filter @aether/api db:seed",
    "db:export:core": "node scripts/export-core-migrations.mjs",
    "openapi:check": "node scripts/check-openapi.mjs",
    "test:client-template": "node scripts/validate-client-template.mjs",
    "create:client": "node scripts/create-client.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "publish:packages": "changeset publish",
    "validate": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test && pnpm check:boundaries && pnpm test:client-template && pnpm openapi:check"
  },
  "devDependencies": {
    "@aether/agent-core": "workspace:^",
    "@aether/observability": "workspace:^",
    "@changesets/cli": "^2.29.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.19.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.0",
    "prettier": "^3.7.0",
    "turbo": "^2.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.17"
    }
  }
}
