{
  "name": "aether-commerce",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:api": "pnpm --filter @aether-commerce/api dev",
    "dev:storefront": "pnpm --filter @aether-commerce/storefront dev",
    "dev:storefront:e2e": "cross-env NEXT_PUBLIC_AETHER_AI_URL=http://localhost:8090 NEXT_PUBLIC_AETHER_E2E=true NEXT_PUBLIC_PORTFOLIO_URL=https://portfolio.example.com pnpm --filter @aether-commerce/storefront exec next dev --port 3010",
    "dev:admin": "pnpm --filter @aether-commerce/admin dev",
    "env:sync": "node scripts/sync-env.mjs",
    "deploy:preflight": "node scripts/check-deploy-config.mjs production",
    "deploy:preflight:development": "node scripts/check-deploy-config.mjs development",
    "build": "turbo build",
    "build:api": "pnpm --filter @aether-commerce/api build",
    "build:storefront": "pnpm --filter @aether-commerce/storefront build",
    "build:admin": "pnpm --filter @aether-commerce/admin build",
    "deploy:development:api": "pnpm --filter @aether-commerce/api run deploy:development",
    "deploy:development:storefront": "pnpm --filter @aether-commerce/storefront run deploy:development",
    "deploy:development:assistant": "wrangler deploy --config apps/ai-assistant/wrangler.development.json --keep-vars",
    "deploy:api": "pnpm --filter @aether-commerce/api run deploy",
    "deploy:storefront": "pnpm --filter @aether-commerce/storefront run deploy",
    "deploy:assistant": "wrangler deploy --config apps/ai-assistant/wrangler.production.json --keep-vars",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "check:boundaries": "node scripts/check-platform-boundaries.mjs",
    "test:e2e": "playwright test",
    "test:e2e:assistant": "playwright test tests/e2e/assistant-widget.spec.ts --project=desktop",
    "db:generate": "pnpm --filter @aether-commerce/api db:generate",
    "db:migrate:local": "pnpm --filter @aether-commerce/api db:migrate:local",
    "db:seed": "pnpm --filter @aether-commerce/api db:seed",
    "db:export:core": "node scripts/export-core-migrations.mjs",
    "openapi:check": "node scripts/check-openapi.mjs",
    "test:client-template": "node scripts/validate-client-template.mjs",
    "create:client": "node scripts/create-client.mjs",
    "changeset": "changeset",
    "check:changesets": "node scripts/check-changesets.mjs",
    "version:packages": "changeset version",
    "publish:packages": "changeset publish",
    "validate": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test && pnpm check:boundaries && pnpm test:client-template && pnpm openapi:check"
  },
  "devDependencies": {
    "@aether-commerce/agent-core": "workspace:^",
    "@aether-commerce/observability": "workspace:^",
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^2.29.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.19.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.7.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "brace-expansion@^1.0.0": "1.1.18",
      "brace-expansion@^2.0.0": "2.1.4",
      "js-yaml": "4.3.1",
      "read-yaml-file>js-yaml": "3.14.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.26"
    }
  }
}
