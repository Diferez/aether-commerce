# Storefront catalog image generation (scripts/generate-images.mjs, not shipped to the browser)
PEXELS_API_KEY=

# Public browser values
NEXT_PUBLIC_AETHER_API_URL=https://aether-api.pickofwow.workers.dev
NEXT_PUBLIC_AETHER_STOREFRONT_URL=https://aether-storefront.pickofwow.workers.dev
NEXT_PUBLIC_AETHER_BASE_PATH=
NEXT_PUBLIC_AETHER_AI_URL=https://aether-ai.pickofwow.workers.dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_PORTFOLIO_URL=https://portafolio-aether-commerce.pickofwow.workers.dev

# Observability - browser (admin + storefront). See docs/observability.md.
# Off by default everywhere: leave NEXT_PUBLIC_SENTRY_ENABLED unset/false to
# run with no Sentry network activity at all.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_PERFORMANCE_SAMPLE_RATE=0.05
# Optional - shown as an "Open Sentry" link on the admin System health page. Leave unset to hide it.
NEXT_PUBLIC_OBSERVABILITY_DASHBOARD_URL=

# Worker secrets and bindings
APP_ORIGIN_STORE=https://aether-storefront.pickofwow.workers.dev
APP_ORIGIN_ADMIN=https://aether-admin.pages.dev
APP_STORE_BASE_PATH=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWT_ISSUER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WOMPI_SECRET_KEY=
WOMPI_EVENTS_SECRET=
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
AETHER_CART_TOKEN_SECRET=
# Encrypts Stripe/Wompi secrets stored via the admin panel at rest in D1.
# Required only to use admin-panel-managed checkout secrets; deploy-time
# secrets above keep working without it.
AETHER_SETTINGS_ENCRYPTION_KEY=
AETHER_ENV=

# Observability - Worker (apps/api). See docs/observability.md.
LOG_LEVEL=info
LOG_INFO_SAMPLE_RATE=0.1
PERFORMANCE_SAMPLE_RATE=0.05
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# CI-only (source map upload) - never referenced by app code, never prefixed NEXT_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
HEALTH_METRICS_RETENTION_DAYS=14
AUDIT_LOG_ENABLED=true

# AI assistant server-side config
AETHER_API_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=600
AI_ASSISTANT_ENABLED=true
AI_MUTATIONS_ENABLED=true
AI_DAILY_REQUEST_BUDGET=
AI_EVAL_MAX_CASES=10
AI_OPERATIONS_TOKEN=
AI_CORS_ALLOWED_ORIGINS=*
AI_INTERNAL_HTTP_RETRIES=2
AI_INTERNAL_CIRCUIT_FAILURE_THRESHOLD=3
AI_INTERNAL_CIRCUIT_RESET_SECONDS=30
AI_CATALOG_CACHE_TTL_SECONDS=60
AI_RATE_LIMIT_MESSAGES_PER_MINUTE=8
AI_RATE_LIMIT_MESSAGES_PER_HOUR=80
AI_RATE_LIMIT_ANONYMOUS_PER_DAY=40
AI_MAX_CONCURRENT_REQUESTS=20
DATABASE_URL=
SUPABASE_DB_PASSWORD=
REDIS_URL=
