# Development Cloudflare URLs
NEXT_PUBLIC_AETHER_API_URL=https://aether-api-dev.pickofwow.workers.dev
NEXT_PUBLIC_AETHER_STOREFRONT_URL=https://aether-storefront-dev.pickofwow.workers.dev
NEXT_PUBLIC_AETHER_BASE_PATH=
NEXT_PUBLIC_AETHER_AI_URL=https://aether-ai-dev.pickofwow.workers.dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_PORTFOLIO_URL=https://portafolio-aether-commerce-dev.pickofwow.workers.dev

# Observability - browser. See docs/observability.md. Off by default.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_PERFORMANCE_SAMPLE_RATE=0.05
NEXT_PUBLIC_OBSERVABILITY_DASHBOARD_URL=

# Development Worker bindings/origins
APP_ORIGIN_STORE=https://aether-storefront-dev.pickofwow.workers.dev
APP_ORIGIN_ADMIN=https://develop.aether-admin.pages.dev
APP_STORE_BASE_PATH=
AETHER_ENV=development

# Observability - Worker. See docs/observability.md.
LOG_LEVEL=debug
LOG_INFO_SAMPLE_RATE=1
PERFORMANCE_SAMPLE_RATE=0.05
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
HEALTH_METRICS_RETENTION_DAYS=14
AUDIT_LOG_ENABLED=true

# Development Cloudflare resource names/ids
AETHER_API_WORKER_NAME=aether-api-dev
AETHER_AI_WORKER_NAME=aether-ai-dev
AETHER_FRONT_WORKER_NAME=aether-storefront-dev
AETHER_ADMIN_PAGES_PROJECT=aether-admin
AETHER_D1_DATABASE_NAME=aether-development
AETHER_D1_DATABASE_ID=

# Storefront catalog image generation
PEXELS_API_KEY=

# Worker/API secrets - use test-mode credentials only in development
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWT_ISSUER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
AETHER_CART_TOKEN_SECRET=

# AI assistant server-side config
AETHER_API_BASE_URL=https://aether-api-dev.pickofwow.workers.dev
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=600
AI_ASSISTANT_ENABLED=true
AI_MUTATIONS_ENABLED=true
AI_DAILY_REQUEST_BUDGET=
AI_OPERATIONS_TOKEN=
AI_CORS_ALLOWED_ORIGINS=https://aether-storefront-dev.pickofwow.workers.dev
DATABASE_URL=
SUPABASE_DB_PASSWORD=
REDIS_URL=
