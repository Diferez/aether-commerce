    "@langchain/core": "1.2.5",
    "@langchain/google-genai": "2.2.0",
    "@langchain/langgraph": "1.4.8",
    "@sentry/cloudflare": "10.70.0",
    "hono": "^4.12.34",
    "jose": "^6.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260812.1",
    "typescript": "^5.9.0"
