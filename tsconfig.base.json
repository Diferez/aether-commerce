{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "paths": {
      "@aether-commerce/api-client": ["./packages/api-client/src/index.ts"],
      "@aether-commerce/api-core": ["./packages/api-core/src/index.ts"],
      "@aether-commerce/api-worker": ["./packages/api-worker/src/index.ts"],
      "@aether-commerce/agent-core": ["./packages/agent-core/src/index.ts"],
      "@aether-commerce/config-schema": ["./packages/config-schema/src/index.ts"],
      "@aether-commerce/core": ["./packages/core/src/index.ts"],
      "@aether-commerce/i18n": ["./packages/i18n/src/index.ts"],
      "@aether-commerce/observability": ["./packages/observability/src/index.ts"],
      "@aether-commerce/schemas": ["./packages/schemas/src/index.ts"],
      "@aether-commerce/storefront-default": ["./packages/storefront-default/src/index.ts"],
      "@aether-commerce/admin-default": ["./packages/admin-default/src/index.ts"],
      "@aether-commerce/ui": ["./packages/ui/src/index.tsx"],
      "@aether-commerce/ui/theme": ["./packages/ui/src/theme.ts"]
    }
  }
}
